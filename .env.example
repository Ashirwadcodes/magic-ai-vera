# Copy this file to .env and fill it in. .env is git-ignored; never commit a real key.

# Free key from https://aistudio.google.com/ -> "Get API key"
GEMINI_API_KEY=
# Which Gemini model to call (check what your free tier allows in AI Studio)
GEMINI_MODEL=gemini-2.5-flash

# Shown publicly on GET /v1/metadata
TEAM_NAME=
TEAM_MEMBERS=
CONTACT_EMAIL=
